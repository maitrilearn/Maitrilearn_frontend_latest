// ── MaitriLearn AI Teacher Board ─────────────────────────────────────────────
const BACKEND = typeof BACKEND_URL      !== "undefined" ? BACKEND_URL      : "http://localhost:5000";
const VOICE   = typeof VOICE_TUTOR_URL  !== "undefined" ? VOICE_TUTOR_URL  : "http://localhost:5001";

// ── State ─────────────────────────────────────────────────────────────────────
let lesson       = null;
let stepIndex    = 0;
let paused       = false;
let running      = false;
let currentAudio = null;
let _timers      = [];

// ── Color palette ─────────────────────────────────────────────────────────────
const COLORS = [
  { bg: "rgba(34,211,238,.15)",  border: "#22d3ee", text: "#22d3ee"  },
  { bg: "rgba(167,139,250,.15)", border: "#a78bfa", text: "#a78bfa"  },
  { bg: "rgba(74,222,128,.15)",  border: "#4ade80", text: "#4ade80"  },
  { bg: "rgba(251,191,36,.15)",  border: "#fbbf24", text: "#fbbf24"  },
  { bg: "rgba(248,113,113,.15)", border: "#f87171", text: "#f87171"  },
  { bg: "rgba(251,146,60,.15)",  border: "#fb923c", text: "#fb923c"  },
];

const STEP_ICONS = {
  title:"🏷", text:"📄", flowchart:"🔀",
  diagram:"🗂", graph:"📊", keypoints:"⭐"
};

// ── Helpers ───────────────────────────────────────────────────────────────────
const $  = id => document.getElementById(id);

function wait(ms) {
  // BUG FIX: wait() uses Promise + setTimeout tracked in _timers
  // so pausing correctly cancels pending waits
  return new Promise(resolve => {
    const t = setTimeout(resolve, ms);
    _timers.push(t);
  });
}

function clearAllTimers() {
  _timers.forEach(clearTimeout);
  _timers = [];
  if (currentAudio) { currentAudio.pause(); currentAudio = null; }
  setTalking(false);
}

function setStatus(text, cls = "") {
  const el = $("statusPill");
  el.textContent = text;
  el.className = "status-pill " + cls;
}

function setSpeech(text) { $("speechText").textContent = text; }

function setTalking(yes) {
  const r = $("avatarRing");
  yes ? r.classList.add("talking") : r.classList.remove("talking");
}

// ── Board panel ───────────────────────────────────────────────────────────────
function clearBoard() {
  $("board-content").innerHTML = "";
  $("idleOverlay").classList.remove("hidden");
}

// BUG FIX: showPanel now REPLACES content instantly — no async fade removal
// that was causing panels to overlap and steps to be skipped
function showPanel(html) {
  $("idleOverlay").classList.add("hidden");
  const content = $("board-content");
  content.innerHTML = html;  // instant replace — no race condition
  const panel = content.firstElementChild;
  // Trigger CSS transition on next frame
  requestAnimationFrame(() => requestAnimationFrame(() => {
    if (panel) panel.classList.add("visible");
  }));
  return panel;
}

// ── Step sidebar ──────────────────────────────────────────────────────────────
function buildStepList(steps) {
  $("stepList").innerHTML = steps.map((s, i) => `
    <div class="step-row" id="srow_${i}">
      <span class="step-icon">${STEP_ICONS[s.type] || "•"}</span>
      <span class="step-dot"></span>
      <span>${s.heading || s.text || s.type}</span>
    </div>
  `).join("");
}

function markStep(i, state) {
  document.querySelectorAll(".step-row").forEach((el, idx) => {
    el.className = "step-row" +
      (idx === i ? " " + state : idx < i ? " done" : "");
  });
}

// ── RENDERERS ─────────────────────────────────────────────────────────────────

async function renderTitle(step) {
  showPanel(`
    <div class="step-panel title-step">
      <div class="title-subject-tag">${lesson.subject || "AI Lesson"}</div>
      <h1 class="title-main" id="titleMain"></h1>
      <div class="title-bar"></div>
      <p class="title-sub">Powered by MaitriLearn AI</p>
    </div>
  `);
  await wait(300);
  // Typewriter
  const title = step.text || lesson.title || "Lesson";
  const el = $("titleMain");
  if (!el) return;
  for (const ch of title) {
    if (paused) return;
    el.textContent += ch;
    await wait(45);
  }
  await wait(700);
}

async function renderText(step) {
  showPanel(`
    <div class="step-panel text-step">
      <h2 class="step-heading">${step.heading || ""}</h2>
      <p class="step-body" id="textBody"></p>
    </div>
  `);
  await wait(300);
  const bodyEl = $("textBody");
  if (!bodyEl) return;

  // BUG FIX: split sentences and fade each in — body was there but
  // all spans starting at opacity 0 before voice fallback rushed past
  const sentences = (step.body || "").split(/(?<=[.!?])\s+/).filter(Boolean);
  for (const s of sentences) {
    if (paused) return;
    const span = document.createElement("span");
    span.style.cssText = "opacity:0;transition:opacity .6s;margin-right:4px;";
    span.textContent = s + " ";
    bodyEl.appendChild(span);
    await wait(80);
    span.style.opacity = "1";
    await wait(400);
  }
  await wait(500);
}

async function renderFlowchart(step) {
  const nodes = step.nodes || [];
  const nodesHTML = nodes.map((n, i) => {
    const c = COLORS[i % COLORS.length];
    const arrow = i < nodes.length - 1
      ? `<div class="flow-arrow" id="farr_${i}">→</div>` : "";
    return `
      <div class="flow-node" id="fnode_${i}">
        <div class="flow-node-box" style="background:${c.bg};border-color:${c.border};color:${c.text}">${n}</div>
        <div class="flow-num">0${i + 1}</div>
      </div>${arrow}`;
  }).join("");

  showPanel(`
    <div class="step-panel flowchart-step">
      <h2 class="step-heading">${step.heading || "Process Flow"}</h2>
      <div class="flow-nodes">${nodesHTML}</div>
    </div>
  `);

  await wait(300);
  for (let i = 0; i < nodes.length; i++) {
    if (paused) return;
    const node = $(`fnode_${i}`);
    if (node) node.classList.add("visible");
    await wait(320);
    const arr = $(`farr_${i}`);
    if (arr) arr.classList.add("visible");
    await wait(150);
  }
  await wait(500);
}

async function renderDiagram(step) {
  const elements = step.elements || [];
  const cardsHTML = elements.map((el, i) => {
    const c = COLORS[i % COLORS.length];
    return `
      <div class="diagram-card" id="dcard_${i}" style="border-left:3px solid ${c.border}">
        <div class="diagram-card-num" style="background:${c.bg};color:${c.text}">${i + 1}</div>
        <div class="diagram-card-label">${el.label}</div>
        <div class="diagram-card-desc">${el.description || ""}</div>
      </div>`;
  }).join("");

  showPanel(`
    <div class="step-panel diagram-step">
      <h2 class="step-heading">${step.heading || "Diagram"}</h2>
      <div class="diagram-grid">${cardsHTML}</div>
    </div>
  `);

  await wait(300);
  for (let i = 0; i < elements.length; i++) {
    if (paused) return;
    const card = $(`dcard_${i}`);
    if (card) card.classList.add("visible");
    await wait(280);
  }
  await wait(500);
}

async function renderGraph(step) {
  const data   = step.data || [];
  const maxVal = Math.max(...data.map(d => d.value), 1);

  const barsHTML = data.map((d, i) => {
    const c = COLORS[i % COLORS.length];
    return `
      <div class="bar-group">
        <div class="bar-value" id="bval_${i}">${d.value}</div>
        <div class="bar-fill" id="bar_${i}" style="background:${c.bg};border:1px solid ${c.border}"></div>
        <div class="bar-label">${d.label}</div>
      </div>`;
  }).join("");

  showPanel(`
    <div class="step-panel graph-step">
      <h2 class="step-heading">${step.heading || "Graph"}</h2>
      <div class="graph-wrap">
        <div class="graph-axis-label">${step.ylabel || "Value"}</div>
        <div class="bar-chart">${barsHTML}</div>
        <div class="graph-axis-label">${step.xlabel || ""}</div>
      </div>
    </div>
  `);

  await wait(400);
  for (let i = 0; i < data.length; i++) {
    if (paused) return;
    const bar  = $(`bar_${i}`);
    const bval = $(`bval_${i}`);
    const h    = Math.round((data[i].value / maxVal) * 190);
    if (bar)  bar.style.height = h + "px";
    await wait(120);
    if (bval) bval.classList.add("visible");
    await wait(120);
  }
  await wait(600);
}

async function renderKeypoints(step) {
  const points = step.points || [];
  const rowsHTML = points.map((p, i) => {
    const c = COLORS[i % COLORS.length];
    return `
      <div class="keypoint-row" id="kp_${i}">
        <div class="keypoint-num" style="background:${c.bg};color:${c.text}">${i + 1}</div>
        <div class="keypoint-text">${p}</div>
      </div>`;
  }).join("");

  showPanel(`
    <div class="step-panel keypoints-step">
      <h2 class="step-heading">${step.heading || "Key Takeaways"}</h2>
      <div class="keypoints-list">${rowsHTML}</div>
    </div>
  `);

  await wait(300);
  for (let i = 0; i < points.length; i++) {
    if (paused) return;
    const kp = $(`kp_${i}`);
    if (kp) kp.classList.add("visible");
    await wait(320);
  }
  await wait(600);
}

async function renderStep(step) {
  switch (step.type) {
    case "title":     await renderTitle(step);     break;
    case "text":      await renderText(step);      break;
    case "flowchart": await renderFlowchart(step); break;
    case "diagram":   await renderDiagram(step);   break;
    case "graph":     await renderGraph(step);     break;
    case "keypoints": await renderKeypoints(step); break;
    default:          await renderText(step);      break;
  }
}

// ── VOICE NARRATION ───────────────────────────────────────────────────────────
// BUG FIX: voice fallback now waits proportionally to text length
// so content has time to render even without voice tutor running
function narrate(text) {
  return new Promise(resolve => {
    setSpeech(text);
    setTalking(true);

    const useVoice = $("voiceToggle").checked;

    // Fallback duration: 50ms per character, min 2s, max 8s
    const fallbackMs = Math.min(Math.max(text.length * 50, 2000), 8000);

    if (!useVoice) {
      const t = setTimeout(() => { setTalking(false); resolve(); }, fallbackMs);
      _timers.push(t);
      return;
    }

    fetch(`${VOICE}/generate`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ prompt: text })
    })
    .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(data => {
      const audio = new Audio(`${VOICE}${data.audio}`);
      currentAudio = audio;
      audio.onended = () => { setTalking(false); currentAudio = null; resolve(); };
      audio.onerror = () => { setTalking(false); currentAudio = null; resolve(); };
      audio.play().catch(() => { setTalking(false); resolve(); });
    })
    .catch(() => {
      // Voice unavailable — wait proportionally then continue
      const t = setTimeout(() => { setTalking(false); resolve(); }, fallbackMs);
      _timers.push(t);
    });
  });
}

// ── LESSON RUNNER ─────────────────────────────────────────────────────────────
async function runStep(index) {
  if (!lesson || index >= lesson.steps.length) {
    setStatus("DONE ✓", "");
    setSpeech("Great job! Lesson complete! 🎉");
    setTalking(false);
    $("startBtn").disabled = false;
    $("pauseBtn").disabled = true;
    running = false;
    return;
  }

  if (paused) return;

  stepIndex = index;
  markStep(index, "active");

  const step = lesson.steps[index];

  await renderStep(step);
  if (paused) return;

  await narrate(step.narration || step.heading || step.text || "");
  if (paused) return;

  markStep(index, "done");
  await wait(400);
  runStep(index + 1);
}

// ── PUBLIC ────────────────────────────────────────────────────────────────────
window.startLesson = async function () {
  const topic = $("topicInput").value.trim();
  if (!topic) { alert("Please enter a topic!"); return; }

  clearAllTimers();
  clearBoard();
  paused    = false;
  running   = true;
  stepIndex = 0;

  $("startBtn").disabled = true;
  $("pauseBtn").disabled = false;
  $("pauseBtn").textContent = "⏸ Pause";
  $("stepList").innerHTML   = "";
  setStatus("LOADING", "loading");
  setSpeech(`Preparing lesson on "${topic}"...`);

  try {
    const res = await fetch(`${BACKEND}/whiteboard/lesson`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ topic })
    });
    if (!res.ok) throw new Error("Backend " + res.status);
    const data = await res.json();
    if (data.error) throw new Error(data.error);

    lesson = data.lesson;
    buildStepList(lesson.steps);
    setStatus("TEACHING", "teaching");
    setSpeech(`Starting: ${lesson.title}!`);
    runStep(0);

  } catch (err) {
    console.error(err);
    setStatus("ERROR", "error");
    setSpeech("Could not load lesson. Check backend connection.");
    $("startBtn").disabled = false;
    $("pauseBtn").disabled = true;
    running = false;
  }
};

window.togglePause = function () {
  paused = !paused;
  const btn = $("pauseBtn");
  if (paused) {
    clearAllTimers();
    btn.textContent = "▶ Resume";
    setStatus("PAUSED", "");
    setSpeech("Lesson paused. Press Resume to continue.");
  } else {
    btn.textContent = "⏸ Pause";
    setStatus("TEACHING", "teaching");
    runStep(stepIndex);
  }
};

window.clearLesson = function () {
  clearAllTimers();
  clearBoard();
  lesson  = null;
  running = false;
  paused  = false;
  $("startBtn").disabled    = false;
  $("pauseBtn").disabled    = true;
  $("pauseBtn").textContent = "⏸ Pause";
  $("stepList").innerHTML   = "";
  setStatus("READY", "");
  setSpeech("Hello! Enter a topic and I'll teach you with visuals! 👋");
};
